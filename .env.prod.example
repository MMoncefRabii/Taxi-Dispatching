# Copy this file to .env.prod and replace the placeholders.
# Keep POSTGRES_USER, POSTGRES_DB, and the password consistent with DATABASE_URL.
# PROXY_PORT selects the host port published by the proxy; the container listens on 8080.
# WEB_ORIGINS and FRONTEND_BASE_URL must use that same host port, for example
# http://localhost:18080 when PROXY_PORT=18080.
# Use the localhost values below for local proxy testing. For a public deployment,
# set CADDY_SITE to https://your-domain.example and use that same origin for
# WEB_ORIGINS and FRONTEND_BASE_URL. Caddy will obtain and renew its HTTPS certificate.
# The dashboard API is same-origin; VITE_API_BASE_URL is built as an empty string.
# WEB_ORIGINS is a comma-separated list of bare origins without paths. HTTP is
# accepted only for exact localhost or 127.0.0.1 hosts during local testing.
# Replace the DATABASE_URL password placeholder with a strong, unique password.
POSTGRES_USER=fleet_tracker
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
POSTGRES_DB=fleet_tracker
DATABASE_URL=postgresql+asyncpg://fleet_tracker:URL_ENCODED_PASSWORD@db:5432/fleet_tracker
PROXY_PORT=8080
CADDY_SITE=http://localhost:8080
WEB_ORIGINS=http://localhost:8080
FRONTEND_BASE_URL=http://localhost:8080
