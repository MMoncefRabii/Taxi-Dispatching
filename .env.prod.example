# Copy this file to .env.prod and replace the placeholders.
# Keep POSTGRES_USER, POSTGRES_DB, and the password consistent with DATABASE_URL.
POSTGRES_USER=fleet_tracker
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
POSTGRES_DB=fleet_tracker
DATABASE_URL=postgresql+asyncpg://fleet_tracker:URL_ENCODED_PASSWORD@db:5432/fleet_tracker
WEB_ORIGINS=https://admin.example.com
FRONTEND_BASE_URL=https://admin.example.com
