# Missing or invalid APP_ENV uses production behavior. Development is for local use only.
APP_ENV=development
WEB_ORIGINS=http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173
DEV_TASKS_ENABLED=false
LOCATION_MAX_FUTURE_SECONDS=60
LOCATION_MAX_AGE_LIVE_SECONDS=300
LOCATION_MAX_AGE_BATCH_SECONDS=21600
LOCATION_MIN_INTERVAL_SECONDS=2
LOCATION_MAX_SPEED_KMH=200
LOCATION_MAX_ACCURACY_M=50
LOCATION_BATCH_MAX=50
# Replace these placeholders before use. URL-encode reserved characters in the password.
POSTGRES_PASSWORD=<password>
DATABASE_URL=postgresql+asyncpg://<user>:<password>@localhost:5432/fleet_tracker
